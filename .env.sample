# AUDIT-VIEWER configuration
# Copy this file to .env and adjust to your environment:
#   cp .env.sample .env
# Relative paths are resolved from the audit-viewer directory.

# Paths to the built-in audit scripts.
# Defaults are selected by OS: .ps1 on Windows, .sh on macOS.
# Uncomment only to override the automatic selection:
# CLAUDE_AUDIT_SCRIPT=../claude-audit/claude_audit.sh
# CODEX_AUDIT_SCRIPT=../codex-audit/codex_audit.sh

# Where to store snapshots (created automatically)
SNAPSHOTS_DIR=snapshots

# HTTP port (can also be overridden with --port)
PORT=8765

# Additional audit tools: TOOL_<id>=<label>:<script_path>
# The script must support --json output with the common schema
# (timestamp / hostname / username / summary / findings).
# Example:
# TOOL_GEMINI=gemini-audit:../gemini-audit/gemini_audit.sh
